{
  "name": "pre.style-demo-tanstack-start",
  "private": true,
  "description": "A TanStack Start app for dogfooding pre.style on the client and server.",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=pre.style-source vite dev",
    "build": "NODE_OPTIONS=--conditions=pre.style-source vite build",
    "start": "NODE_OPTIONS=--conditions=pre.style-source vite preview",
    "typecheck": "tsr generate && tsc"
  },
  "dependencies": {
    "@pre.style/core": "3.1.0-alpha.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "pre.style-demo-react-ui": "0.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@pre.style/vite": "3.1.0-alpha.3",
    "@tanstack/router-cli": "^1.167.46",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lightningcss": "^1.33.0",
    "sass": "^1.106.1",
    "vite": "^8.3.5"
  },
  "pre.style": {
    "include": [
      "src/**/*.{ts,tsx}"
    ],
    "prependFiles": {
      "scss": [
        "../ui/src/styles/_tokens.scss"
      ]
    }
  }
}
