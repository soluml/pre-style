{
  "name": "pre.style-demo-react-router",
  "private": true,
  "description": "A React Router app (framework mode) for dogfooding pre.style on the client and server.",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=pre.style-source react-router dev",
    "build": "NODE_OPTIONS=--conditions=pre.style-source react-router build",
    "start": "NODE_OPTIONS=--conditions=pre.style-source react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/node": "^8.5.0",
    "@react-router/serve": "^8.5.0",
    "isbot": "^5.2.2",
    "pre.style": "3.0.0-alpha.0",
    "pre.style-demo-react-ui": "0.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lightningcss": "^1.33.0",
    "sass": "^1.106.1",
    "vite": "^8.3.5",
    "vite-plugin-pre.style": "3.0.0-alpha.0"
  }
}
