{
  "name": "pre.style-demo-astro",
  "private": true,
  "description": "An Astro app with React islands for dogfooding pre.style on the client and server.",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=pre.style-source astro dev",
    "build": "NODE_OPTIONS=--conditions=pre.style-source astro build",
    "start": "NODE_OPTIONS=--conditions=pre.style-source node ./dist/server/entry.mjs",
    "typecheck": "astro sync && tsc"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.1",
    "@pre.style/core": "3.1.0-alpha.0",
    "astro": "^7.4.2",
    "pre.style-demo-react-ui": "0.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@pre.style/vite": "3.1.0-alpha.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lightningcss": "^1.33.0",
    "sass": "^1.106.1",
    "vite": "^8.3.5"
  },
  "pre.style": {
    "include": [
      "src/**/*.{ts,tsx,astro}"
    ],
    "prependFiles": {
      "scss": [
        "../react/ui/src/styles/_tokens.scss"
      ]
    }
  }
}
