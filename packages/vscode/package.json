{
  "name": "pre-style",
  "displayName": "pre.style",
  "version": "3.1.0",
  "private": true,
  "description": "Editor support for pre.style: color coding and CSS completion in css and scss blocks, validation and completion for the pre.style field in package.json, and TypeScript setup for stylesheet imports.",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "atomic-css",
    "css",
    "css-in-js",
    "pre.style",
    "scss",
    "zero-runtime"
  ],
  "homepage": "https://pre.style",
  "bugs": {
    "url": "https://github.com/soluml/pre.style/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Benjamin Solum",
    "email": "benjamin@soluml.com",
    "url": "https://soluml.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/soluml/pre.style/",
    "directory": "packages/vscode"
  },
  "publisher": "pre-style",
  "files": [
    "dist/extension.cjs",
    "dist/package.json.schema.json",
    "syntaxes"
  ],
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/vscode": "~1.95.0",
    "esbuild": "^0.28.2",
    "jsonc-parser": "^3.3.1",
    "tm-grammars": "^1.32.22",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-languageserver-textdocument": "^1.0.16",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "package.json",
        "url": "./dist/package.json.schema.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "source.pre-style",
        "path": "./syntaxes/pre-style.tmLanguage.json"
      },
      {
        "scopeName": "inline.pre-style.js",
        "path": "./syntaxes/inline-js.tmLanguage.json",
        "injectTo": [
          "source.js",
          "source.js.jsx",
          "source.ts",
          "source.tsx",
          "text.html.basic",
          "source.astro"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.pre-style.css": "css",
          "meta.embedded.block.pre-style.scss": "scss"
        }
      },
      {
        "scopeName": "inline.pre-style.html",
        "path": "./syntaxes/inline-html.tmLanguage.json",
        "injectTo": [
          "text.html.basic"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.pre-style.css": "css",
          "meta.embedded.block.pre-style.scss": "scss"
        }
      }
    ],
    "commands": [
      {
        "command": "pre-style.setUpTypes",
        "title": "Set Up TypeScript Types",
        "category": "pre.style"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:astro",
    "onLanguage:html",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "engines": {
    "node": ">=24",
    "vscode": "^1.95.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
