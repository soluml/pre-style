{
  "name": "@pre.style/vite",
  "version": "3.1.0-alpha.0",
  "description": "Vite plugin for pre.style.",
  "keywords": [
    "atomic-css",
    "css-in-js",
    "pre.style",
    "vite",
    "vite-plugin",
    "zero-runtime"
  ],
  "homepage": "https://pre.style",
  "bugs": {
    "url": "https://github.com/soluml/pre.style/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Benjamin Solum",
    "email": "benjamin@soluml.com",
    "url": "https://soluml.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/soluml/pre.style/",
    "directory": "packages/vite"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "pre.style-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "prepack": "npm run build -w @pre.style/core -w @pre.style/vite && cp ../../README.md ../../LICENSE .",
    "postpack": "rm README.md LICENSE",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --conditions=pre.style-source --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@pre.style/core": "3.1.0-alpha.0",
    "magic-string": "^1.4.3",
    "oxc-parser": "^0.155.0"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "lightningcss": "^1.33.0",
    "sass": "^1.106.1",
    "vite": "^8.3.5"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
