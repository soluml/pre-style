{
  "name": "pre-style-monorepo",
  "private": true,
  "workspaces": [
    "packages/pre-style",
    "packages/vite-plugin-pre-style",
    "demo"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build -w packages/pre-style -w packages/vite-plugin-pre-style",
    "typecheck": "npm run typecheck -w packages/pre-style -w packages/vite-plugin-pre-style",
    "test": "npm test -w packages/pre-style -w packages/vite-plugin-pre-style",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "demo": "npm run dev -w demo",
    "demo:build": "npm run build -w demo",
    "demo:start": "npm run start -w demo"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
