{
  "name": "pre.style-monorepo",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/vite",
    "demo/react/*",
    "demo/astro"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build -w packages/core -w packages/vite",
    "typecheck": "npm run typecheck -w packages/core -w packages/vite",
    "test": "npm test -w packages/core -w packages/vite",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "demo:react-router": "npm run dev -w demo/react/react-router",
    "demo:react-router:build": "npm run build -w demo/react/react-router",
    "demo:react-router:start": "npm run start -w demo/react/react-router",
    "demo:tanstack-start": "npm run dev -w demo/react/tanstack-start",
    "demo:tanstack-start:build": "npm run build -w demo/react/tanstack-start",
    "demo:tanstack-start:start": "npm run start -w demo/react/tanstack-start",
    "demo:astro": "npm run dev -w demo/astro",
    "demo:astro:build": "npm run build -w demo/astro",
    "demo:astro:start": "npm run start -w demo/astro",
    "www": "npm run dev --prefix src/www",
    "www:build": "npm run build --prefix src/www"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
