---
import { css } from '@pre.style/core';
import Layout from '../layouts/Layout.astro';
import Logo from '../img/wordmark.svg';

const hero = css`
  display: grid;
  place-items: center;
  margin: auto;
  padding: 2rem 1rem;
  text-align: center;
  max-width: 40rem;
  width: 100%;
  padding: 1rem;
`;


const visuallyHidden = css`
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
  border: 0;
`;

const logo = css`
  aspect-ratio: 1022/362;
  display: block;
  fill: currentcolor;
  user-select: none;
  pointer-events: none;
  max-width: 100%;
  width: min(100%, 32rem);
  height: auto;
  margin: 0 auto 1.5rem;
`;

const tagline = css`
  font-weight: 400;
  font-size: 1.25rem;
  line-height: 1.4;
  margin: 0 0 2rem;
  text-wrap: balance;

  @media (min-width: 768px) {
    font-size: 1.5rem;
  }
`;

const badge = css`
  color: #fff;
  display: inline-block;
  margin: 0 0 2rem;
  padding: 0.375rem 1rem;
  border-radius: 999px;
  background-color: rgb(0 0 0 / 0.75);
  font-size: 0.875rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
`;

const code = css`
  color: #fff;
  display: block;
  margin: 0 0 2rem;
  padding: 1rem;
  border-radius: 0.5rem;
  background-color: rgb(0 0 0 / 0.75);
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 0.9375rem;
  overflow-x: auto;
  white-space: nowrap;
  max-width: 100%;
`;

const link = css`
  color: currentcolor;
  font-weight: 500;
  text-decoration: underline;
  text-decoration-skip-ink: none;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.2em;

  &:hover {
    text-decoration-thickness: 2px;
  }
`;
---

<Layout
  title="pre.style: zero-runtime CSS-in-JS"
  description="Write plain CSS or SCSS next to your markup, and pre.style compiles it at build time into atomic CSS classes. Docs coming soon."
>
  <main class={hero}>
    <h1 class={css`margin: 0;`}>
      <span class={visuallyHidden}>pre.style</span>
      <Logo class={logo} aria-hidden="true" focusable="false" />
    </h1>
    <p class={tagline}>
      Zero-runtime CSS-in-JS. Write plain CSS or SCSS next to your markup, and pre.style compiles
      it at build time into atomic CSS classes.
    </p>
    <p class={badge}>Docs coming soon</p>
    <code class={code}>npm i -D @pre.style/vite lightningcss</code>
    <p class={css`display: inline-flex; gap: .25rem;`}>
      <a class={link} href="https://github.com/soluml/pre.style">GitHub</a>
      &bull;
      <a class={link} href="https://www.npmjs.com/package/@pre.style/core">npm</a>
    </p>
  </main>
</Layout>
