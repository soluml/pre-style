---
import { css } from '@pre.style/core';
import Layout from '../layouts/Layout.astro';
import Logo from '../img/wordmark.svg';

const hero = css`
  display: grid;
  place-items: center;
  margin: auto;
  padding: 2rem 1rem;
  text-align: center;
  max-width: 40rem;
  width: 100%;
  padding: 1rem;
`;


const visuallyHidden = css`
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
  border: 0;
`;

const logo = css`
  aspect-ratio: 1022/362;
  display: block;
  fill: currentcolor;
  user-select: none;
  pointer-events: none;
  max-width: 100%;
  width: min(100%, 32rem);
  height: auto;
  margin: 0 auto 1.5rem;
`;

const tagline = css`
  font-weight: 400;
  font-size: 1.25rem;
  line-height: 1.4;
  margin: 0 0 2rem;
  text-wrap: balance;

  @media (min-width: 768px) {
    font-size: 1.5rem;
  }
`;

const badge = css`
  color: #fff;
  display: inline-block;
  margin: 0 0 2rem;
  padding: 0.375rem 1rem;
  border-radius: 999px;
  background-color: rgb(0 0 0 / 0.75);
  font-size: 0.875rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
`;

// What screen readers hear and the copy button copies, whatever the width.
const installCommand = 'npm install --save-dev @pre.style/vite lightningcss';

// The install command grows with the space it has. Its full-width wrapper is
// the container (the code box itself shrinks to its text), and shares the
// code's font, so in its container queries `ch` is one code character. Each
// breakpoint is the length of the command it reveals, plus the box's chrome:
// 4.5rem of padding and the copy button. The visible command is hidden from
// assistive tech, which always gets the full command instead.
const install = css`
  container-type: inline-size;
  width: 100%;
  margin: 0 0 2rem;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 0.9375rem;
`;

const codeBox = css`
  color: #fff;
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  padding: 0.5rem;
  border-radius: 0.5rem;
  background-color: rgb(0 0 0 / 0.75);
`;

const code = css`
  font-family: inherit;
  font-size: inherit;
  min-width: 0;
  overflow-x: auto;
  padding: 0.5rem;
  white-space: nowrap;
  /* Keeps the visually hidden full command inside this scroller, rather than
     widening the page when the command overflows. */
  position: relative;
`;

const flagShort = css`
  @container (width >= calc(43ch + 4.5rem)) {
    display: none;
  }
`;

const flagMedium = css`
  display: none;

  @container (calc(43ch + 4.5rem) <= width < calc(51ch + 4.5rem)) {
    display: inline;
  }
`;

const flagLong = css`
  display: none;

  @container (width >= calc(51ch + 4.5rem)) {
    display: inline;
  }
`;

// Kept out of text selection, so copying the visible command doesn't pick up
// a second copy of it.
const srCommand = css`
  user-select: none;
`;

const copyButton = css`
  display: grid;
  place-items: center;
  flex: none;
  width: 2.5rem;
  height: 2.5rem;
  padding: 0;
  border: 0;
  border-radius: 0.375rem;
  background: none;
  color: rgb(255 255 255 / 0.8);
  cursor: pointer;

  &:hover {
    background-color: rgb(255 255 255 / 0.12);
    color: #fff;
  }

  &:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  &[hidden] {
    display: none;
  }
`;

const link = css`
  color: currentcolor;
  font-weight: 500;
  text-decoration: underline;
  text-decoration-skip-ink: none;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.2em;

  &:hover {
    text-decoration-thickness: 2px;
  }
`;
---

<Layout
  title="pre.style: zero-runtime CSS-in-JS"
  description="Write plain CSS or SCSS next to your markup, and pre.style compiles it at build time into atomic CSS classes. Docs coming soon."
>
  <main class={hero}>
    <h1 class={css`margin: 0;`}>
      <span class={visuallyHidden}>pre.style</span>
      <Logo class={logo} aria-hidden="true" focusable="false" />
    </h1>
    <p class={tagline}>
      Zero-runtime CSS-in-JS. Write plain CSS or SCSS next to your markup, and pre.style compiles
      it at build time into atomic CSS classes.
    </p>
    <p class={badge}>Docs coming soon</p>
    <div class={install}>
      <div class={codeBox}>
        <code class={code}>
          <span aria-hidden="true">
            npm <span class={flagShort}>i -D</span><span class={flagMedium}>install -D</span><span class={flagLong}>install --save-dev</span> @pre.style/vite lightningcss
          </span>
          <span class:list={[visuallyHidden, srCommand]}>{installCommand}</span>
        </code>
        <button class={copyButton} type="button" data-copy={installCommand} hidden>
          <span class={visuallyHidden}>Copy install command</span>
          <svg data-icon="copy" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="9" y="9" width="12" height="12" rx="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <svg data-icon="done" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="display: none">
            <path d="M20 6 9 17l-5-5" />
          </svg>
        </button>
        <span class={visuallyHidden} role="status" data-copy-status></span>
      </div>
    </div>
    <p class={css`display: inline-flex; gap: .25rem;`}>
      <a class={link} href="https://github.com/soluml/pre.style">GitHub</a>
      &bull;
      <a class={link} href="https://www.npmjs.com/package/@pre.style/core">npm</a>
    </p>
  </main>
</Layout>

<script>
  // The copy button stays hidden unless the Clipboard API is available, so it
  // never shows up broken.
  if (navigator.clipboard) {
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      const status = button.parentElement!.querySelector('[data-copy-status]')!;
      const [copyIcon, doneIcon] = button.querySelectorAll<SVGElement>('[data-icon]');
      let timer: ReturnType<typeof setTimeout>;

      button.hidden = false;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy!);
          status.textContent = 'Copied to clipboard';
          copyIcon.style.display = 'none';
          doneIcon.style.display = '';
        } catch {
          status.textContent = "Couldn't copy. Select the command to copy it instead.";
        }

        clearTimeout(timer);
        timer = setTimeout(() => {
          status.textContent = '';
          copyIcon.style.display = '';
          doneIcon.style.display = 'none';
        }, 2000);
      });
    }
  }
</script>
