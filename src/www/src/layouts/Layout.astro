---
import { Font } from 'astro:assets';
import { scss } from '@pre.style/core';

import './reset.css' with { type: 'pre.style' };
import 'virtual:pre.style.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const body = scss`
  --bg-grid-color: rgb(0 0 0 / .135);
  --bg-grid-gap: 40px;
  $gridStops: var(--bg-grid-color) 0px, var(--bg-grid-color) 1px, transparent 1px, transparent var(--bg-grid-gap);

  background-color: #da5b06;
  background-image:    
    repeating-linear-gradient(to bottom, $gridStops),
    repeating-linear-gradient(to right, $gridStops),
    linear-gradient(165deg, oklch(100% 0.24 77), oklch(92% 0.41 64));
  background-position: top, left;
  color: rgb(0 0 0 / 0.85);
  display: flex;
  flex-direction: column;
  font-family: var(--font-geist);
  line-height: 1.5;
  margin: 0;
  min-height: 100%;
  width: 100%;

  // &::before {
  //   animation: fadeInOut 1.06s ease-in-out infinite;
  //   background-color: color-mix(in srgb, var(--bg-grid-color), black 15%);
  //   position: absolute;
  //   content: '';
  //   left: 0;
  //   top: var(--bg-grid-gap);
  //   height: 3px;
  //   transform: translateY(-50%);
  //   width: calc(var(--bg-grid-gap) / 2);
  // }

  // @keyframes fadeInOut {
  //   0%, 40% { opacity: 1; }
  //   50%, 90% { opacity: 0; }
  //   100% { opacity: 1; }
  // }
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <Font cssVariable="--font-geist" preload />
  </head>
  <body class={body}>
    <slot />
  </body>
</html>
