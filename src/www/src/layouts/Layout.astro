---
import { Font } from 'astro:assets';
import { scss } from '@pre.style/core';

import './reset.css' with { type: 'pre.style' };
import 'virtual:pre.style.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const body = scss`
  --bg-grid-gap: 40px;

  $gridColor: rgb(0 0 0 / .035);
  $gridStops: $gridColor 0px, $gridColor 1px, transparent 1px, transparent var(--bg-grid-gap);

  background-color: #da5b06;
  background-image:    
    repeating-linear-gradient(to bottom, $gridStops),
    repeating-linear-gradient(to right, $gridStops),
    linear-gradient(165deg, oklch(100% 0.24 77), oklch(92% 0.41 64));
  background-position: top;
  color: rgb(0 0 0 / 0.85);
  display: flex;
  flex-direction: column;
  font-family: var(--font-geist);
  line-height: 1.5;
  margin: 0;
  min-height: 100%;
  width: 100%;
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <Font cssVariable="--font-geist" preload />
  </head>
  <body class={body}>
    <slot />
  </body>
</html>
