---
import { Font } from 'astro:assets';
import { css } from '@pre.style/core';
// pre.style's CSS. Astro bundles it in builds, and links it on every page
// that uses this layout.
import 'virtual:pre.style.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const body = css`
  background-color: #da5b06;
  background-image: linear-gradient(165deg, oklch(95% 0.24 77), oklch(92% 0.41 64));
  background-repeat: no-repeat;
  color: rgb(0 0 0 / 0.85);
  display: flex;
  flex-direction: column;
  font-family: var(--font-geist);
  line-height: 1.5;
  margin: 0;
  min-height: 100%;
  width: 100%;
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <Font cssVariable="--font-geist" preload />
  </head>
  <body class={body}>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  :root {
    height: 100%;
    width: 100%;
  }
</style>
